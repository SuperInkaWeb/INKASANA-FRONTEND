# Variables de entorno necesarias para desplegar INKASANA-FRONTEND
# (Vercel, Netlify, o cualquier plataforma de sitios estáticos)
#
# Copia este archivo como .env, rellena los valores y en la plataforma de
# hosting agrégalas en su panel de "Environment Variables" también.

# URL pública del backend (Render, Railway, o el dominio final).
VITE_API_URL=

# --- Auth0 (deben coincidir con la app configurada en Auth0) ---
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
